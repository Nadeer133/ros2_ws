<launch>
    <!-- Define paths -->
    <let name="urdf_path" 
         value="$(find-pkg-share my_robot_description)/urdf/AGV_model.xacro" />

     <!-- Gazebo_Worlds paths -->    
    <let name="worlds_path" 
         value="$(find-pkg-share my_ros2_bringup)/worlds/test_world.sdf" />

    <!-- bridging gazebo and ros2-->
    <let name="gazebo_config_path"
         value="$(find-pkg-share my_ros2_bringup)/config/AGV_bridge.yaml" />

    <!-- AGV slam params config-->
    <let name="agv_slam_params_path"
         value="$(find-pkg-share my_ros2_bringup)/config/AGV_slam_params.yaml" />

    <!-- Robot State Publisher -->
    <node pkg="robot_state_publisher" exec="robot_state_publisher">
        <param name="robot_description" value="$(command 'xacro $(var urdf_path)')" />
    </node>

    <!-- launchin gazebo with emty simulation -->
    <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
        <arg name="gz_args" value="-r $(var worlds_path)"/>
        <!-- <arg name="gz_args" value="-r empty.sdf"/> -->
    </include> 

    <!-- spawning the robot -->
    <node pkg="ros_gz_sim" exec="create" args="-topic robot_description"/>
    
    <!-- bridging gazebo and ros2-->
    <node pkg="ros_gz_bridge" exec="parameter_bridge">
          <param name="config_file" value="$(var gazebo_config_path)"/>
    </node> 

    <!-- Rviz_Config_Path-->
    <let name="agv_rviz_config_path"
         value="$(find-pkg-share my_robot_description)/rviz/AGV_Rviz_Config.rviz"/>

    <!-- RViz2 node loading the custom config -->
    <node
    pkg="rviz2"
    exec="rviz2"
    output="screen"
    args="-d $(var agv_rviz_config_path)">

    <param name="use_sim_time" value="true"/>
    </node>

    <!-- Joint State Broadcaster -->
    <node
    pkg="controller_manager"
    exec="spawner"
    name="joint_state_broadcaster_spawner"
    args="joint_state_broadcaster --controller-manager /controller_manager"
    output="screen"/>

    <!-- Ackermann Steering Controller -->
    <node
    pkg="controller_manager"
    exec="spawner"
    name="ackermann_controller_spawner"
    args="ackermann_steering_controller --controller-manager /controller_manager --controller-ros-args=-r --controller-ros-args=/ackermann_steering_controller/tf_odometry:=/tf"
    output="screen"/>

    <!-- Keyboard Teleoperation -->
    <node
    pkg="teleop_twist_keyboard"
    exec="teleop_twist_keyboard"
    name="keyboard_teleop"
    output="screen"
    launch-prefix="xterm -e"
    args="--ros-args -p stamped:=true -r /cmd_vel:=/ackermann_steering_controller/reference"
    />

    <!-- launching SLAM Toolbox -->
    <include file="$(find-pkg-share slam_toolbox)/launch/online_async_launch.py">
        <arg name="slam_params_file" value="$(var agv_slam_params_path)"/>
        <arg name="use_sim_time" value="true"/>
    </include>

</launch>