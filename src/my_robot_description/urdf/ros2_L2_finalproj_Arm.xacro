<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <link name="arm_base_link">
            <visual>
                <geometry>
                    <box size="${arm_base_length} ${arm_base_width} ${arm_base_height}"/>
                </geometry>
                <origin xyz="0 0 ${arm_base_height/2}" rpy="0 0 0"/>
                <material name="orange"/>
            </visual>
            <collision>
                <geometry>
                    <box size="${arm_base_length} ${arm_base_width} ${arm_base_height}"/>
                </geometry>
                <origin xyz="0 0 ${arm_base_height/2}" rpy="0 0 0"/>
            </collision>
            <xacro:box_inertia m="0.5" x="${arm_base_length}" y="${arm_base_width}" z="${arm_base_height}" o_xyz="0 0 ${arm_base_height/2}" o_rpy="0 0 0" />
    </link>

    <link name="forearm_link">
            <visual>
                <geometry>
                    <cylinder radius="${forearm_radius}" length="${forearm_length}"/>
                </geometry>
                <origin xyz="0 0 ${(forearm_length)/2}" rpy="0 0 0"/>
                <material name="yellow"/>
            </visual>
            <xacro:forearm_inertia m="0.3" r="${forearm_radius}" h="${forearm_length}" o_xyz="0 0 0" o_rpy="0 0 0" />
            <collision>
                <geometry>
                    <cylinder radius="${forearm_radius}" length="${forearm_length}"/>
                </geometry>
                <origin xyz="0 0 ${(forearm_length)/2}" rpy="0 0 0"/>
            </collision>
    </link>

    <link name="hand_link">
            <visual>
                <geometry>
                    <cylinder radius="${hand_radius}" length="${hand_length}"/>
                </geometry>
                <origin xyz="0 0 ${forearm_length/2}" rpy="0 0 0"/>
                <material name="orange"/>
            </visual>
            <xacro:hand_inertia m="0.3" r="${hand_radius}" h="${hand_length}" o_xyz="0 0 0" o_rpy="0 0 0" />
            <collision>
                <geometry>
                    <cylinder radius="${hand_radius}" length="${hand_length}"/>
                </geometry>
                <origin xyz="0 0 ${forearm_length/2}" rpy="0 0 0"/>
            </collision>
    </link>

    <joint name="arm_base_forearm_joint" type="revolute">
        <parent link="arm_base_link"/>
        <child link="forearm_link"/>
        <origin xyz="0 0 ${arm_base_height}" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="0.0" upper="${pi/2.0}" effort="100.0" velocity="0.5"/>
        <dynamics damping="0.3" friction="0.3"/>
    </joint>

    <joint name="forearm_hand_joint" type="revolute">
        <parent link="forearm_link"/>
        <child link="hand_link"/>
        <origin xyz="0 0 ${forearm_length}" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="0.0" upper="${pi/2.0}" effort="100.0" velocity="0.5"/>
        <dynamics damping="0.3" friction="0.3"/>
    </joint>

</robot>