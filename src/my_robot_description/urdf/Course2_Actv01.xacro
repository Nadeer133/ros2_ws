<?xml version="1.0"?>
<robot name="my_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="base_length" value="0.6" />
    <xacro:property name="base_width" value="0.4" />
    <xacro:property name="base_height" value="0.2" />
    <xacro:property name="wheel_radius" value="0.1" />
    <xacro:property name="wheel_length" value="0.05" />

    <xacro:include filename="common_properties.xacro"/>
    <xacro:include filename="mobile_base.xacro"/>
    <xacro:include filename="mobile_base_gazebo.xacro"/>
    <xacro:include filename="camera.xacro"/>
</robot>
<!-- THIS PART IS COMMENTED OUT TO DEMONSTRATE THE USAGE OF XACRO INSIDE ANOTHER XACRO
    <link name="base_link">
        <visual>
            <geometry>
               <box size="${base_length} ${base_width} ${base_height}"/>     
            </geometry>
            <origin xyz="0 0 0.1" rpy="0 0 0"/>
            <material name ="blue"/>
        </visual>
    </link>    

    <xacro:macro name="wheel_macro" params= "prefix">
        <link name="${prefix}_wheel_link">
        <visual>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
            <material name="grey"/>
        </visual>
    </link>
    </xacro:macro>

    <xacro:wheel_macro prefix="left"/>
    <xacro:wheel_macro prefix="right"/>

    <! THIS PART IS COMMENTED OUT TO DEMONSTRATE THE USAGE OF XACRO FUNCTION/MACROS

        <link name="right_wheel_link">
        <visual>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
            <material name="grey"/>
        </visual>
    </link>

    <link name="left_wheel_link">
        <visual>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
            <material name="grey"/>
        </visual>
    </link> 

    <link name="caster_wheel_link">
        <visual>
            <geometry>
                <sphere radius="0.05" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="grey"/>
        </visual>
    </link>

    <link name="base_footprint_link">
        
    </link>

    <joint name="base_right_Wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel_link"/>
        <origin xyz="${-base_length/4.0} ${-((base_width/2.0)+(wheel_length/2.0))} 0" rpy="0 0 0"/>
        <axis xyz="0 1 0" />
    </joint>

    <joint name="base_left_Wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel_link"/>
        <origin xyz="${-base_length/4.0} ${((base_width/2.0)+(wheel_length/2.0))} 0" rpy="0 0 0"/>
        <axis xyz="0 1 0" />
    </joint>

    <joint name="base_caster_Wheel_joint" type="fixed">
        <parent link="base_link"/>
        <child link="caster_wheel_link"/>
        <origin xyz="${base_length/3.0} 0 -0.05" rpy="0 0 0"/>
        <axis xyz="0 0 0" />
    </joint>

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint_link"/>
        <child link="base_link"/>
        <origin xyz="0 0 0.1" rpy="0 0 0"/>
        <axis xyz="0 0 0" />
    </joint>

</robot>
-->