<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<link name="base_link">
        <visual>
            <geometry>
               <box size="${base_length} ${base_width} ${base_height}"/>     
            </geometry>
            <origin xyz="0 0 0.1" rpy="0 0 0"/>
            <material name ="blue"/>
        </visual>
        <xacro:box_inertia m="5.0" x="${base_length}" y="${base_width}" z="${base_height}" o_xyz="0 0 0.1" o_rpy="0 0 0" />
        <collision>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
            <origin xyz="0 0 0.1" rpy="0 0 0"/>
        </collision>
    </link>    

    <xacro:macro name="wheel_macro" params= "prefix">
        <link name="${prefix}_wheel_link">
        <visual>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
            <material name="grey"/>
        </visual>
        <xacro:wheel_inertia m="1.0" r="${wheel_radius}" h="${wheel_length}" o_xyz="0 0 0" o_rpy="${pi/2.0} 0 0" />
        <collision>
            <geometry>
                <sphere radius="${wheel_radius}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
        </collision>
    </link>
    </xacro:macro>

    <xacro:wheel_macro prefix="left"/>
    <xacro:wheel_macro prefix="right"/>
    
    <link name="caster_wheel_link">
        <visual>
            <geometry>
                <sphere radius="0.05" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="grey"/>
        </visual>
        <xacro:caster_wheel_inertia m="0.5" r="0.05" o_xyz="0 0 0" o_rpy="0 0 0"/>
        <collision>
            <geometry>
                <sphere radius="0.05" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </collision>
    </link>

    <link name="base_footprint_link">
        
    </link>

    <joint name="base_right_Wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel_link"/>
        <origin xyz="${-base_length/4.0} ${-((base_width/2.0)+(wheel_length/2.0))} 0" rpy="0 0 0"/>
        <axis xyz="0 1 0" />
    </joint>

    <joint name="base_left_Wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel_link"/>
        <origin xyz="${-base_length/4.0} ${((base_width/2.0)+(wheel_length/2.0))} 0" rpy="0 0 0"/>
        <axis xyz="0 1 0" />
    </joint>

    <joint name="base_caster_Wheel_joint" type="fixed">
        <parent link="base_link"/>
        <child link="caster_wheel_link"/>
        <origin xyz="${base_length/3.0} 0 -0.05" rpy="0 0 0"/>
        <axis xyz="0 0 0" />
    </joint>

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint_link"/>
        <child link="base_link"/>
        <origin xyz="0 0 0.1" rpy="0 0 0"/>
        <axis xyz="0 0 0" />
    </joint>

</robot>